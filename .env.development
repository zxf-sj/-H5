# 开发环境
NODE_ENV=development
VUE_APP_ENV=development

# 接口前缀：必须是相对路径 /api，走 devServer 代理（见 config/webpack.dev.js 的 proxy）
# 注意：这里绝不能写成 https://qice.lebian.xyz 绝对地址——
#   那样请求会绕过代理直接跨域打后端，而后端未配 CORS（无 Access-Control-* 响应头），
#   受保护的 /BusOrder/* 会被身份验证拦成 302 跳转 /Login/Index。
VUE_APP_BASE_API=/api

# 代理真实后端地址（开发时 npm run dev 会代理到这里；换成你的后端即可）
DEV_PROXY_TARGET=https://qice.lebian.xyz

# 是否开启 vConsole 调试面板 / 是否打印请求日志
VUE_APP_ENABLE_VCONSOLE=false
VUE_APP_ENABLE_API_LOG=true

# —— Liberty_Login_Token（测试环境专属，生产 .env 必须为 false）——
# 为 true 时：发业务请求前先确保已登录，令牌由后端 Set-Cookie 下发、浏览器自动携带。
# 令牌值同时取自 /Login/MobileLogin 返回的 data 用于本地缓存判活，到期（默认 35 分钟）自动重新获取。
# 关键：后端只认 Cookie，不认同名请求头；且 Cookie 要能存住，BASE_API 必须同源（走 /api 代理）。
VUE_APP_LIBERTY_TOKEN=true
VUE_APP_LIBERTY_ACCOUNT=system
VUE_APP_LIBERTY_PASSWORD=lbj123321
VUE_APP_LIBERTY_TTL_MINUTES=35
