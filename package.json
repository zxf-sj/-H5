{
  "name": "h5-houtai",
  "version": "1.0.0",
  "private": true,
  "description": "Vue2 H5 后台项目：axios + ElementUI + sass/less + vue-router，webpack 热更新，构建产物可直接打开的 index.html",
  "scripts": {
    "dev": "webpack serve --config config/webpack.dev.js",
    "serve": "npm run dev",
    "build": "webpack --config config/webpack.prod.js",
    "build:test": "webpack --config config/webpack.test.js",
    "build:prod": "webpack --config config/webpack.prod.js",
    "build:home": "webpack --config config/webpack.page.js --env page=Home",
    "build:admin": "webpack --config config/webpack.page.js --env page=BusAdmin",
    "build:operations": "webpack --config config/webpack.page.js --env page=BusOperations",
    "build:order": "webpack --config config/webpack.page.js --env page=BusOrderFlow",
    "build:pages": "npm run build:home && npm run build:admin && npm run build:operations && npm run build:order",
    "start": "npm run dev"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "element-ui": "^2.15.14",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.11.0",
    "dotenv": "^17.4.2",
    "html-webpack-plugin": "^5.6.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "mini-css-extract-plugin": "^2.9.0",
    "sass": "1.69.5",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  }
}
